# Compose reads this file. scripts/dev.py reads shell variables instead.
GRIMOIRE_PORT=8080
GRIMOIRE_AI_PROVIDER=native
GRIMOIRE_EMBEDDING_PROVIDER=native
# Host directory mounted read-only at /models; supply your own GGUF files.
GRIMOIRE_MODELS_DIR=./models
GRIMOIRE_NATIVE_MODEL_PATH=/models/chat.gguf
GRIMOIRE_NATIVE_EMBEDDING_MODEL_PATH=/models/embed.gguf
GRIMOIRE_NATIVE_CONTEXT_SIZE=8192
GRIMOIRE_NATIVE_EMBEDDING_CONTEXT_SIZE=2048
# CPU by default. GPU requires a compatible llama-cpp-python build.
GRIMOIRE_NATIVE_GPU_LAYERS=0
GRIMOIRE_NATIVE_THREADS=
GRIMOIRE_NATIVE_CHAT_FORMAT=
GRIMOIRE_MAX_OUTPUT_TOKENS=2048
# Optional compatibility: select ollama above and enable --profile ollama.
GRIMOIRE_MODEL=qwen2.5:3b
# Embedding identity is persisted; changing it requires re-ingestion.
GRIMOIRE_EMBEDDING_MODEL=nomic-embed-text
# For native development use http://127.0.0.1:11434 instead.
GRIMOIRE_OLLAMA_URL=http://ollama:11434
GRIMOIRE_DATA_DIR=/app/data
GRIMOIRE_MAX_UPLOAD_BYTES=2097152
GRIMOIRE_RETRIEVAL_THRESHOLD=0.45
GRIMOIRE_LOG_LEVEL=INFO
